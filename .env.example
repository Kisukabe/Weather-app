# ============================================================
# 🌤️ WEATHER MLOPS ENVIRONMENT CONFIGURATION
# ============================================================

# --- Server Settings ---
APP_NAME="Weather Forecast Bias Correction MLOps"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# --- Security & Auth ---
API_KEY="weather-mlops-dev-secret-key"
CORS_ORIGINS="http://localhost:8501,http://localhost:3000,https://weather-forecast.vercel.app"

# --- Rate Limiting ---
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# --- Log Retention (Bytes & Backup Count) ---
LOG_MAX_BYTES=10485760 # 10 MB per file
LOG_BACKUP_COUNT=5     # Max 5 files = 50 MB total retention

# --- Scheduler Settings ---
SCHEDULE_CRON_HOUR=6
SCHEDULE_CRON_MINUTE=0
AUTO_TRAIN_ENABLED=true

# --- Database ---
SQLITE_DB_PATH="artifacts/weather_history.db"
DB_RETENTION_DAYS=30
